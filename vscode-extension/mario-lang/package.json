{
  "name": "mario-lang",
  "displayName": "Mario Lang",
  "description": "Syntax highlighting and file icons for Mario Lang",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samueljcurtis111/Mario_Lang_Official.git",
    "directory": "vscode-extension/mario-lang"
  },
  "icon": "IMG_5765.jpg",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "mario",
      "aliases": ["Mario", "mario"],
      "extensions": [".mario"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./IMG_5765.jpg",
        "dark": "./IMG_5765.jpg"
      }
    }],
    "grammars": [{
      "language": "mario",
      "scopeName": "source.mario",
      "path": "./syntaxes/mario.tmLanguage.json"
    }]
  }
}