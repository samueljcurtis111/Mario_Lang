{
  "name": "Mario Lang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#mario-9" },
    { "include": "#mario-8-endloop" },
    { "include": "#mario-7-beginloop" },
    { "include": "#mario-6-write" },
    { "include": "#mario-5-read" },
    { "include": "#mario-4-left" },
    { "include": "#mario-3-right" },
    { "include": "#mario-2-sub" },
    { "include": "#mario-1-add" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mario",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mario",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mario",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mario",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "mario-9": {
      "patterns": [
        {
          "name": "invalid.illegal.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-8-endloop": {
      "patterns": [
        {
          "name": "keyword.control.loop.end.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-7-beginloop": {
      "patterns": [
        {
          "name": "keyword.control.loop.begin.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-6-write": {
      "patterns": [
        {
          "name": "support.function.io.print.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-5-read": {
      "patterns": [
        {
          "name": "support.function.io.read.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-4-left": {
      "patterns": [
        {
          "name": "variable.parameter.mario",
          "match": "\\bmario\\s+mario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-3-right": {
      "patterns": [
        {
          "name": "storage.type.mario",
          "match": "\\bmario\\s+mario\\s+mario\\b"
        }
      ]
    },
    "mario-2-sub": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.mario",
          "match": "\\bmario\\s+mario\\b"
        }
      ]
    },
    "mario-1-add": {
      "patterns": [
        {
          "name": "constant.numeric.mario",
          "match": "\\bmario\\b"
        }
      ]
    }
  },
  "scopeName": "source.mario"
}